# Frontend (Vite)
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_PROJECT_ID=
VITE_API_URL=http://localhost:8000

# SSR / server
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
# Required for `bun run seed:admins` — Dashboard → Settings → API Keys → Secret keys → **default** (Reveal, full sb_secret_...)
# Do not use a restricted "demo" secret unless it has full access.
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PROJECT_ID=

# Founder admin seed (local only — not committed): ADMIN_SEED_PASSWORD='...' bun run seed:admins

